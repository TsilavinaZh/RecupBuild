<?php exit; ?>
# Copy to backend-php/.env.php and fill in. That file is ignored by git and never deployed;
# the line above makes it print nothing if a web server runs it.
# MODEL_API_KEY is the name Meta's documentation uses; MUSE_IMAGE_API_KEY is the same key.
MODEL_API_KEY=
MUSE_IMAGE_API_KEY=
META_API_BASE=https://api.meta.ai/v1
VISION_MODEL=muse-spark-1.3

# "Sign in with Google" done by the server (Google Cloud Console > Clients, type
# "Web application"). The secret stays here: never in the frontend.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed as is under "Authorized redirect URIs". Empty: http(s)://<host>/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# SQLite file. Empty: backend-php/storage/recupbuild.sqlite (keep it outside public/).
DATABASE_PATH=

# Comma separated list of origins allowed by CORS. Not needed when the frontend
# and the API share the same origin (the usual case on a VPS).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma separated list of e-mails whose account opens the back office (/admin):
# watch every account, see the AI credits left, set them again. Empty: nobody.
ADMIN_EMAILS=

# SMTP for the welcome e-mail sent at the first sign-in (STARTTLS, usually port 587).
# Empty SMTP_HOST: no e-mail is sent (sign-in still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=