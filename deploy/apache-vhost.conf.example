# RecupBuild, Apache VirtualHost (LAMP, classic hosting / cPanel).
#
# Adjust DocumentRoot and the PHP-FPM paths. mod_rewrite must be on (a2enmod rewrite) and
# AllowOverride All must allow the project's .htaccess, which serves the site's files and
# sends everything else to index.php. The database and the photos live in
# /var/www/recupbuild/recupbuild-storage, outside the project (writable by www-data).

<VirtualHost *:80>
    ServerName recupbuild.example.com
    DocumentRoot /var/www/recupbuild/backend-php

    <Directory /var/www/recupbuild/backend-php>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    # The code, the tests, the docs and the secrets are never served.
    <DirectoryMatch "/var/www/recupbuild/backend-php/(src|tests|docs|deploy|\.git)">
        Require all denied
    </DirectoryMatch>
    <FilesMatch "^\.env">
        Require all denied
    </FilesMatch>

    # PHP-FPM: these settings live in the virtual host, the .htaccess cannot carry them.
    # <FilesMatch \.php$>
    #     SetHandler "proxy:unix:/run/php/php8.3-fpm.sock|fcgi://localhost"
    # </FilesMatch>

    ErrorLog ${APACHE_LOG_DIR}/recupbuild-error.log
    CustomLog ${APACHE_LOG_DIR}/recupbuild-access.log combined
</VirtualHost>
