# RecupBuild — API PHP (VPS)
#
# Equivalent de backend/app/main.py: le frontend Vue (`public/index.html` construit)
# et l'API partagent le même origine, la clé API est lue dans backend-php/.env.
#
# Changer `root`, puis : sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name recupbuild.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name recupbuild.example.com;

    # ssl_certificate     /etc/letsencrypt/live/recupbuild.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/recupbuild.example.com/privkey.pem;

    root /var/www/recupbuild/backend-php/public;
    index index.html index.php;
    charset utf-8;

    # Une photo pèse jusqu'à 12 Mo, l'analyse demande jusqu'à ~120 s.
    client_max_body_size 12m;
    fastcgi_read_timeout 300s;
    send_timeout 300s;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 300s;
    }

    # Les secrets ne sortent jamais du serveur.
    location ~ /\.(env|ini|log) { deny all; }
    location ~ /\.ht { deny all; }

    location ~* \.(js|css|png|jpg|jpeg|webp|svg|woff2?)$ {
        expires 7d;
        access_log off;
    }
}