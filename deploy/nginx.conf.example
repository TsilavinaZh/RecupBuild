# RecupBuild on a VPS (nginx + PHP-FPM).
#
# The site's files sit at the project root next to index.php; the secrets are in
# backend-php/.env.php, the database and the photos in /var/www/recupbuild/recupbuild-storage
# (outside the project, writable by www-data).
#
# Change `root`, then: sudo nginx -t && sudo systemctl reload nginx

server {
    listen 80;
    listen [::]:80;
    server_name recupbuild.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name recupbuild.example.com;

    # ssl_certificate     /etc/letsencrypt/live/recupbuild.example.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/recupbuild.example.com/privkey.pem;

    root /var/www/recupbuild/backend-php;
    index index.php;
    charset utf-8;

    # A photo weighs up to 12 MB, the analysis takes up to ~120 s.
    client_max_body_size 12m;
    fastcgi_read_timeout 300s;
    send_timeout 300s;

    # The site's own files, served as they are.
    location ~ ^/(css|js|fonts|images|vendor|demo|examples)/ {
        try_files $uri =404;
        expires 7d;
        access_log off;
    }
    location = /favicon.svg { try_files $uri =404; }

    # Everything else is a page of the app: the code, the tests, the docs and the
    # secrets are never served, whatever the address.
    location / {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_read_timeout 300s;
    }
}
