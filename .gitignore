# Secrets: the API key and the Google client secret live in .env.php, never in git.
.env
.env.*
!.env.example

# The database and the photos live outside the project (../recupbuild-storage); just in case:
storage/
*.sqlite*

# Pitch material kept next to the project: voice recordings, narration audio and texts,
# source photos (the ones the app uses are copied into demo/ and examples/).
/*.m4a
/*.wav
/*.mp3
/*.jpeg
/*.jpg
/narration*.txt

# The pitch video is large and re-rendered often: share it by link, not through git.
docs/video/*.mp4

# Logs, OS and editor files.
*.log
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
